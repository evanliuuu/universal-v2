{
  "name": "instruction-close-calendar-clears-handlers",
  "description": "NL close instruction drops compiled handlers for the closed app",
  "steps": [
    {
      "event": { "type": "instruction", "value": "open calendar" },
      "assert": { "path": "/handlers/focus-calendar", "exists": true }
    },
    {
      "event": { "type": "instruction", "value": "close calendar" },
      "assert": { "path": "/handlers/focus-calendar", "exists": false },
      "expectTier": "agent-big"
    }
  ]
}
