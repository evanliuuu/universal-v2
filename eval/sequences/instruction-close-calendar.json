{
  "name": "instruction-close-calendar",
  "description": "NL close instruction removes an open calendar window via the agent",
  "steps": [
    {
      "event": { "type": "instruction", "value": "open calendar" },
      "assert": { "path": "/windows/win-calendar", "exists": true }
    },
    {
      "event": { "type": "instruction", "value": "close calendar" },
      "assert": { "path": "/windows/win-calendar", "exists": false },
      "expectTier": "agent-big"
    },
    {
      "event": { "type": "instruction", "value": "open calendar" },
      "assert": { "path": "/windows/win-calendar", "exists": true },
      "expectTier": "agent-big"
    }
  ]
}
