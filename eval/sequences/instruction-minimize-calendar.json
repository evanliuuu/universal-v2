{
  "name": "instruction-minimize-calendar",
  "description": "NL minimize instruction hides an open calendar window without closing it",
  "steps": [
    {
      "event": { "type": "instruction", "value": "open calendar" },
      "assert": { "path": "/windows/win-calendar", "exists": true }
    },
    {
      "event": { "type": "instruction", "value": "minimize calendar" },
      "assert": { "path": "/windows/win-calendar/minimized", "eq": true },
      "expectTier": "agent-big"
    },
    {
      "event": { "type": "instruction", "value": "open calendar" },
      "assert": { "path": "/windows/win-calendar/minimized", "eq": false },
      "expectTier": "agent-big"
    }
  ]
}
