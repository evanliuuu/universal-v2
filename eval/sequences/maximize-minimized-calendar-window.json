{
  "name": "maximize-minimized-calendar-window",
  "description": "Green maximize on a minimized window unminimizes it and fills the desktop",
  "steps": [
    {
      "event": { "type": "click", "targetId": "dock-calendar" },
      "assert": { "path": "/windows/win-calendar", "exists": true }
    },
    {
      "event": { "type": "minimize_window", "value": "win-calendar" },
      "assert": { "path": "/windows/win-calendar/minimized", "eq": true },
      "expectTier": "reflex"
    },
    {
      "event": { "type": "maximize_window", "value": "win-calendar" },
      "assert": { "path": "/windows/win-calendar/minimized", "eq": false },
      "expectTier": "reflex"
    },
    {
      "event": { "type": "maximize_window", "value": "win-calendar" },
      "assert": { "path": "/windows/win-calendar/maximized", "eq": false },
      "expectTier": "reflex"
    }
  ]
}
