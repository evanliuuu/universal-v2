{
  "name": "resize-calendar-window",
  "description": "resize_window reflex updates window dimensions",
  "steps": [
    {
      "event": { "type": "click", "targetId": "dock-calendar" },
      "assert": { "path": "/windows/win-calendar", "exists": true }
    },
    {
      "event": {
        "type": "resize_window",
        "value": { "windowId": "win-calendar", "width": 640, "height": 480 }
      },
      "assert": { "path": "/windows/win-calendar/width", "eq": 640 },
      "expectTier": "reflex"
    }
  ]
}
