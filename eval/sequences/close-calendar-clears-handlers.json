{
  "name": "close-calendar-clears-handlers",
  "description": "Closing a window via the titlebar drops compiled handlers so they are not left behind",
  "steps": [
    {
      "event": { "type": "click", "targetId": "dock-calendar" },
      "assert": { "path": "/handlers/focus-calendar", "exists": true }
    },
    {
      "event": { "type": "close_window", "value": "win-calendar" },
      "assert": { "path": "/handlers/focus-calendar", "exists": false },
      "expectTier": "reflex"
    }
  ]
}
