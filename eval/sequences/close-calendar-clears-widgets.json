{
  "name": "close-calendar-clears-widgets",
  "description": "Closing a window via the titlebar drops nested widgets so they are not left behind",
  "steps": [
    {
      "event": { "type": "click", "targetId": "dock-calendar" },
      "assert": { "path": "/widgets/calendar-toolbar", "exists": true }
    },
    {
      "event": { "type": "close_window", "value": "win-calendar" },
      "assert": { "path": "/widgets/calendar-toolbar", "exists": false },
      "expectTier": "reflex"
    }
  ]
}
