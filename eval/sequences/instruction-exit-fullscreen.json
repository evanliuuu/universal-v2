{
  "name": "instruction-exit-fullscreen",
  "description": "Exit fullscreen unmaximizes the focused window instead of treating it as maximize",
  "steps": [
    {
      "event": { "type": "instruction", "value": "open notes" },
      "assert": { "path": "/windows/win-notes", "exists": true }
    },
    {
      "event": { "type": "instruction", "value": "maximize this window" },
      "assert": { "path": "/windows/win-notes/maximized", "eq": true }
    },
    {
      "event": { "type": "instruction", "value": "exit fullscreen" },
      "assert": { "path": "/windows/win-notes/maximized", "eq": false },
      "expectTier": "agent-big"
    }
  ]
}
