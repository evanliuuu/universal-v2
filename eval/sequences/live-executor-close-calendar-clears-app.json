{
  "name": "live-executor-close-calendar-clears-app",
  "description": "Incomplete live close patches still drop the leftover calendar app record",
  "agentMode": "live-fixture",
  "steps": [
    {
      "event": { "type": "instruction", "value": "open calendar" },
      "assert": { "path": "/apps/calendar/open", "eq": true },
      "expectTier": "agent-big"
    },
    {
      "event": { "type": "instruction", "value": "close the calendar window" },
      "modelPatches": {
        "statePatch": [
          { "op": "remove", "path": "/windows/win-calendar" }
        ],
        "uiPatch": [],
        "rationale": "Closing calendar from incomplete model patches."
      },
      "assert": { "path": "/apps/calendar", "exists": false },
      "expectTier": "agent-big"
    }
  ]
}
