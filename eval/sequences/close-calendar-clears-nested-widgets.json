{
  "name": "close-calendar-clears-nested-widgets",
  "description": "Closing a window via the titlebar removes nested widgets, not just the window root",
  "steps": [
    {
      "event": { "type": "click", "targetId": "dock-calendar" },
      "assert": { "path": "/widgets/cal-label", "exists": true }
    },
    {
      "event": { "type": "close_window", "value": "win-calendar" },
      "assert": { "path": "/widgets/cal-label", "exists": false },
      "expectTier": "reflex"
    }
  ]
}
