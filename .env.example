VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
VITE_OPENROUTER_BIG_MODEL=anthropic/claude-sonnet-4
VITE_OPENROUTER_PLANNER_MODEL=anthropic/claude-sonnet-4
VITE_OPENROUTER_EXECUTOR_MODEL=anthropic/claude-sonnet-4
# Local Node server (npm run server) or Cloudflare Worker (npm run cloud:dev)
VITE_WS_URL=ws://localhost:5174/ws
VITE_SYNC_API_URL=http://localhost:8787
UNIVERSAL_SERVER_PORT=8787
# Cloud (optional): set after `wrangler deploy`
# VITE_WS_URL=wss://universal-v2.<account>.workers.dev/ws
# VITE_SYNC_API_URL=https://universal-v2.<account>.workers.dev
