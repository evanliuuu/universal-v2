# VITE_SYNC_API_URL=http://127.0.0.1:8787
UNIVERSAL_SERVER_PORT=8787
# Public cloud (after `npm run cloud:deploy` / wrangler deploy)
VITE_WS_URL=wss://universal-v2.evanliuuu.workers.dev/ws
VITE_SYNC_API_URL=https://universal-v2.evanliuuu.workers.dev
